# syntax=docker/dockerfile:1

FROM golang:1.26.5-alpine AS revision

ARG PAJE_COMMIT
RUN printf '%s\n' "${PAJE_COMMIT}" | grep -Eq '^[0-9a-f]{40}$' \
    || { printf '%s\n' 'PAJE_COMMIT must be a full 40-character lowercase hexadecimal Git commit' >&2; exit 1; }

FROM revision AS init-build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/paje-sandbox-init \
    ./cmd/paje-sandbox-init

FROM node:24.4.1-alpine3.22

ARG CA_CERTIFICATES_PACKAGE_VERSION=20260611-r0
ARG CODEX_VERSION=0.144.5
ARG GIT_PACKAGE_VERSION=2.49.1-r0
RUN apk add --no-cache \
    "ca-certificates=${CA_CERTIFICATES_PACKAGE_VERSION}" \
    "git=${GIT_PACKAGE_VERSION}" \
    && npm install --global "@openai/codex@${CODEX_VERSION}" \
    && npm cache clean --force \
    && test "$(codex --version)" = "codex-cli ${CODEX_VERSION}"

COPY --from=revision /usr/local/go /usr/local/go
COPY --from=init-build /out/paje-sandbox-init /usr/local/bin/paje-sandbox-init

ARG PAJE_COMMIT
LABEL org.opencontainers.image.revision="${PAJE_COMMIT}" \
    org.opencontainers.image.source="https://github.com/araihu/paje" \
    io.araihu.paje.codex.version="${CODEX_VERSION}" \
    io.araihu.paje.git.version="2.49.1" \
    io.araihu.paje.go.version="1.26.5" \
    io.araihu.paje.node.version="24.4.1"

RUN addgroup -S -g 65532 paje \
    && adduser -S -D -H -u 65532 -G paje paje \
    && mkdir -p /workspace /run/paje /home/paje /tmp \
    && chown 65532:65532 /workspace /run/paje /home/paje /tmp

ENV HOME=/home/paje \
    GOCACHE=/home/paje/.cache/go-build \
    GOMODCACHE=/home/paje/go/pkg/mod \
    PATH=/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin \
    TMPDIR=/tmp
WORKDIR /workspace
USER 65532:65532

ENTRYPOINT []
CMD []
